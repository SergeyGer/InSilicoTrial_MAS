# ---------------------------------------------------------------------------
# Template for local development. Copy it to `.env` and fill in what you need:
#
#     cp .env.example .env        # .env is git-ignored and never committed
#
# Nothing in this file is required to run the platform. With no credentials the
# deterministic offline persona provider is used, which is what CI and the demo
# rely on. Every variable below is either a standard SDK variable (AWS, OpenAI,
# Databricks, MLflow) or a platform override with the INSILICO_ prefix.
#
# VS Code loads this file automatically (".env" is configured in
# .vscode/settings.json) and so does `set -a; source .env; set +a` in a shell.
# ---------------------------------------------------------------------------

# --- LLM provider ----------------------------------------------------------
# offline | mock | bedrock | openai | langchain
INSILICO_LLM__PROVIDER=offline
# bedrock: cross-region inference profile id (never hardcode a model id in code)
# INSILICO_LLM__MODEL=us.anthropic.claude-3-5-sonnet-20241022-v2:0
# INSILICO_LLM__REGION=us-east-1
# INSILICO_LLM__REQUESTS_PER_SECOND=8
# INSILICO_LLM__MAX_CONCURRENCY=32
# openai-compatible endpoint (also used for a local gateway/proxy)
# INSILICO_LLM__ENDPOINT_URL=

# --- AWS / Amazon Bedrock --------------------------------------------------
# Use one of: static keys, a named profile, an assumed role, or the instance role.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_PROFILE=
# AWS_ROLE_ARN=
# AWS_WEB_IDENTITY_TOKEN_FILE=
# AWS_REGION=us-east-1
# AWS_DEFAULT_REGION=us-east-1

# --- OpenAI ----------------------------------------------------------------
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# --- Databricks ------------------------------------------------------------
# Personal access token or OAuth machine-to-machine (preferred in CI).
# DATABRICKS_HOST=https://dbc-xxxxxxxx-xxxx.cloud.databricks.com
# DATABRICKS_TOKEN=
# DATABRICKS_CLIENT_ID=
# DATABRICKS_CLIENT_SECRET=
# DATABRICKS_CONFIG_PROFILE=

# --- MLflow ----------------------------------------------------------------
# Empty means "file://<output_dir>/mlruns" locally, or the workspace default on Databricks.
# MLFLOW_TRACKING_URI=
# MLFLOW_TRACKING_USERNAME=
# MLFLOW_TRACKING_PASSWORD=

# --- Simulation overrides (anything in conf/*.yaml can be set this way) -----
# INSILICO_ENGINE__BACKEND=auto          # auto | sequential | local | spark
# INSILICO_N_PATIENTS=10000
# INSILICO_N_COHORTS=40
# INSILICO_EPOCHS=8
# INSILICO_SEED=20240517
# INSILICO_LLM_MODE=triggered            # off | sample | triggered | all
# INSILICO_STORAGE__BACKEND=local        # local | delta | memory
# INSILICO_STORAGE__CATALOG=trial_simulations_prod
# INSILICO_ML__BACKEND=auto              # auto | mechanistic | ridge
# INSILICO_TRACKING__ENABLED=true
# INSILICO_OUTPUT_DIR=artifacts/local
# INSILICO_LOG_LEVEL=INFO

# --- Optional runtime paths ------------------------------------------------
# JAVA_HOME=/path/to/jdk-17            # required only for the Spark engine
# PYSPARK_PYTHON=/path/to/venv/bin/python
