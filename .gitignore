# --- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.python-version

# --- Distribution archives ------------------------------------------------
# Release tarballs and wheels are build outputs, and a stray archive picked up by
# `git add -A` is both huge and unreviewable.
*.tar.gz
*.tgz
*.zip
*.whl

# --- Test / lint caches ---------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
junit.xml

# --- Local toolchain (portable JRE used for local Spark runs) -------------
.toolchain/

# --- Simulation artefacts -------------------------------------------------
artifacts/
data/raw/
data/bronze/
data/silver/
data/gold/
reports/
*.parquet
*.delta/
spark-warehouse/
metastore_db/
derby.log
mlruns/
mlflow.db

# --- UI previews -----------------------------------------------------------
# docs/studio-preview.html and docs/dashboard-preview.html are committed on
# purpose (regenerate with `make architecture`); per-run dashboards are not.
dashboard.html

# --- Secrets / infrastructure state --------------------------------------
# `.env.example` is committed as a template; real values never are.
.env
.env.*
!.env.example
*.tfstate
*.tfstate.*
.terraform/
terraform.tfvars
crash.log

# --- Notebooks / editors --------------------------------------------------
.ipynb_checkpoints/
.databricks/
.vscode/*.log
*.swp
.DS_Store
